<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="message-handling-container">
                <p class="message-handling-message">
                </p>
            </div>
            <div class="modal-header contact-header">
                <h2 class="modal-title" id="contactModalLabel">Contact</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeForm()"></button>
            </div>
            <div class="modal-body contact-body">
                <p class="modal-subtitle mb-4">Interesse in ons aanbod? Vragen? Laat het ons weten via dit formulier. We nemen snel contact met je op!</p>

                <form id="contactForm" data-ajax="true" data-ajax-success="contactOnSuccess" data-ajax-failure="contactOnFailed" method="post" onsubmit="disableSubmitButton()" action="/Contact/SendEmail?culture=nl-BE">
                    <div class="mb-3">
                        <label for="Name" class="required">Naam</label>
                        <input class="mb-2" type="text" data-val="true" data-val-required="Gelieve je naam in te vullen" id="Name" name="Name" value="">
                        <span class="text-danger field-validation-valid" data-valmsg-for="Name" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mb-3">
                        <label for="Email" class="required">E-mail</label>
                        <input class="mb-2" type="text" data-val="true" data-val-regex="Gelieve een geldig e-mailadres in te vullen" data-val-regex-pattern="^([a-zA-Z0-9_\-\.]&#x2B;)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]&#x2B;\.)&#x2B;))([a-zA-Z]{2,15}|[0-9]{1,3})(\]?)$" data-val-required="Gelieve een geldig e-mailadres in te vullen" id="Email" name="Email" value="">
                        <span class="text-danger field-validation-valid" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mb-3">
                        <label for="Message" class="required">Voer hier je bericht in</label>
                        <textarea class="mb-2" rows="10" data-val="true" data-val-length="Je bericht kan max Voer hier je bericht in karakters bevatten." data-val-length-max="500" data-val-required="Gelieve een bericht in te vullen" id="Message" maxlength="500" name="Message">
</textarea>
                        <span class="text-danger field-validation-valid" data-valmsg-for="Message" data-valmsg-replace="true"></span>
                    </div>
