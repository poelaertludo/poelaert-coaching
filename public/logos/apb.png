<script>
    function setToolbarNotificationCookie(dateUpdated) {
        var expiration_date = new Date();
        expiration_date.setHours(23);
        expiration_date.setMinutes(59);
        expiration_date.setSeconds(59);
        expiration_date.setMilliseconds(999);
        document.cookie = `toolbarNotification=${dateUpdated};secure;path=/;expires=" + ${expiration_date.toUTCString()}`;
        $('#toolbarMessage').addClass('d-none');
    }
</script>



